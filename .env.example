# URL pública (si no se define, en Vercel se usa el dominio de producción del proyecto)
SITE_URL=https://tu-dominio.com

# Email de contacto mostrado en el footer y en las páginas legales
VITE_CONTACT_EMAIL=

# ─── Agenda propia (funciones de /api) ───────────────────────────────────────
# Base de datos Neon: la crea Vercel al conectar Storage → Neon. En local: npx vercel env pull .env.local
DATABASE_URL=

# Google Calendar (cliente OAuth "Aplicación web"; el refresh token lo genera `npm run google:auth`)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendario donde se crean las reservas (vacío = principal). La disponibilidad descuenta también el principal.
GOOGLE_CALENDAR_ID=

# Emails (Resend). Sin clave no se envían emails propios; la invitación de Google llega igualmente.
RESEND_API_KEY=
EMAIL_FROM="mrl. studio <agenda@tu-dominio.com>"
ADMIN_EMAIL=

# Secretos aleatorios: openssl rand -base64 32
BOOKING_SECRET=
CRON_SECRET=
